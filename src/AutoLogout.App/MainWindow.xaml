<Window x:Class="AutoLogout.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AutoLogout" Width="660" Height="590" MinWidth="570" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#F5F7FB">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,16"><TextBlock FontSize="27" FontWeight="Bold" Text="AutoLogout"/><TextBlock Foreground="#556170" Text="Windows 시작 / 종료 시 지정한 사이트의 브라우저 로그인 데이터 정리" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock FontWeight="SemiBold" FontSize="15" Text="사이트 Origin (한 줄에 하나)"/><TextBlock Margin="0,4,0,8" Foreground="#667085" Text="정확한 Origin을 입력하세요. 예: https://github.com"/><TextBox x:Name="Sites" Height="170" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14" Padding="10"/></StackPanel>
  <StackPanel Grid.Row="2" Margin="0,18,0,0"><CheckBox x:Name="AtStartup" Content="Windows 사용자 로그인 시 정리" IsChecked="True" Margin="0,0,0,10"/><CheckBox x:Name="AtShutdown" Content="Windows 정상 종료 / 재시작 / 사용자 로그아웃 시 정리 시도" IsChecked="True" Margin="0,0,0,10"/><CheckBox x:Name="Autostart" Content="Windows 사용자 로그인 시 AutoLogout 자동 실행" IsChecked="True"/></StackPanel>
  <StackPanel Grid.Row="3" Margin="0,19,0,0"><TextBlock FontWeight="SemiBold" Text="상태"/><TextBlock x:Name="Status" Margin="0,7,0,0" Foreground="#475467" TextWrapping="Wrap"/><TextBlock Margin="0,12,0,0" Foreground="#667085" TextWrapping="Wrap" Text="주의: 이 프로그램은 서버의 원격 세션을 해지하는 것이 아니라 브라우저의 사이트 데이터 삭제를 요청합니다. 해당 브라우저와 확장 프로그램이 실행 중이어야 요청을 처리할 수 있습니다."/></StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Width="110" Height="38" Margin="0,0,9,0" Content="지금 정리" Click="RunNow_Click"/><Button Width="130" Height="38" Content="설정 저장" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>

